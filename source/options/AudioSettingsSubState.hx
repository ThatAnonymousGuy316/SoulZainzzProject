using StringTools;

class AudioSettingsSubState extends BaseOptionsMenu
{
	public function new()
	{
		title = 'Audio Settings';
		rpcTitle = 'Audio Settings Menu'; //for Discord Rich Presence

		var option:Option = new Option('Hitsound Volume',
			'Funny notes does \"Tick!\" when you hit them."',
			'hitsoundVolume',
			'percent',
			0);
		addOption(option);
		option.scrollSpeed = 1.6;
		option.minValue = 0.0;
		option.maxValue = 1;
		option.changeValue = 0.1;
		option.decimals = 1;
		option.onChange = onChangeHitsoundVolume;

		var option:Option = new Option('MissSound Volume',
			'Funny notes does an Annoying noise on Miss',
			'missSoundVolume',
			'percent',
			0.3);
		addOption(option);
		option.scrollSpeed = 1.6;
		option.minValue = 0.0;
		option.maxValue = 1;
		option.changeValue = 0.1;
		option.decimals = 1;
		option.onChange = onChangeMissSoundVolume;

		var option:Option = new Option('Vocals Volume',
			'Changes the vocals volume of the song',
			'vocalsVolume',
			'percent',
			1);
		addOption(option);
		option.scrollSpeed = 1.6;
		option.minValue = 0.0;
		option.maxValue = 1;
		option.changeValue = 0.1;
		option.decimals = 1;
		option.onChange = nothing;

		super();
	}

	function onChangeHitsoundVolume()
	{
		FlxG.sound.play(Paths.sound('hitsound'), ClientPrefs.hitsoundVolume);
	}

	function onChangeMissSoundVolume()
	{
		FlxG.sound.play(Paths.soundRandom('missnote', 1, 3), ClientPrefs.missSoundVolume);
	}

	function nothing(){}
}